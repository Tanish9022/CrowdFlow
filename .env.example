# Crowd Flow Environment Configuration Template

# Application
APP_NAME="Crowd Flow Traffic Intelligence"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Server Host & Port
HOST="127.0.0.1"
PORT=8000

# Security
SECRET_KEY="crowd_flow_super_secret_development_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default: local SQLite for portability during Viva)
DATABASE_URL="sqlite:///./crowd_flow.db"

# CCTV & CV Parameters
YOLO_MODEL_PATH="models/yolov8n.pt"
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
FRAME_SKIP_RATE=2
MAX_CAMERA_STREAMS=6

# Simulation Defaults
DEFAULT_CYCLE_TIME_SECONDS=90
MIN_GREEN_TIME_SECONDS=15
MAX_GREEN_TIME_SECONDS=70
